datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ntn         String?
  strn        String?
  email       String
  phone       String
  currency    String   @default("PKR")
  timezone    String   @default("Asia/Karachi")
  address     String?
  city        String?  @default("Lahore")
  country     String   @default("Pakistan")
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  isFbrReady  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions     Subscription[]
  branches          Branch[]
  users             User[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]
  sales             Sale[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  stockLedgers      StockLedger[]
  expenses          Expense[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  syncQueues        SyncQueue[]
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  type          String   // STARTER, PROFESSIONAL, BUSINESS, ENTERPRISE
  monthlyPrice  Float
  annualPrice   Float
  maxBranches   Int      @default(1)
  maxUsers      Int      @default(3)
  maxProducts   Int      @default(1000)
  maxRegisters  Int      @default(2)
  features      String   // JSON string of enabled feature flags
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id              String   @id @default(uuid())
  tenantId        String
  planId          String
  status          String   @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, CANCELLED, SUSPENDED
  billingCycle    String   @default("MONTHLY") // MONTHLY, ANNUAL
  startDate       DateTime @default(now())
  endDate         DateTime
  nextBillingDate DateTime
  autoRenew       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  city      String?  @default("Lahore")
  phone     String?
  email     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses        Warehouse[]
  cashRegisters     CashRegister[]
  users             User[]
  sales             Sale[]
  inventoryBalances InventoryBalance[]
  stockLedgers      StockLedger[]
  purchaseOrders    PurchaseOrder[]
  expenses          Expense[]

  @@unique([tenantId, code])
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryBalances InventoryBalance[]
  stockLedgers      StockLedger[]

  @@unique([branchId, code])
}

model User {
  id                    String    @id @default(uuid())
  tenantId              String
  branchId              String?
  name                  String
  email                 String
  passwordHash          String
  role                  String    // SUPER_ADMIN, BUSINESS_OWNER, BRANCH_MANAGER, CASHIER, etc.
  phone                 String?
  isActive              Boolean   @default(true)
  emailVerified         Boolean   @default(true)
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  refreshTokenHash      String?
  twoFactorEnabled      Boolean   @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  cashSessions CashSession[]
  sales        Sale[]
  auditLogs    AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@unique([tenantId, email])
}

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  parentId    String?
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@unique([tenantId, slug])
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  categoryId     String
  name           String
  sku            String
  barcode        String
  description    String?
  brand          String?
  unit           String   @default("PIECE") // PIECE, KG, LITRE, CARTON, etc.
  purchasePrice  Float    @default(0)
  retailPrice    Float    @default(0)
  wholesalePrice Float?   @default(0)
  taxRate        Float    @default(18.0) // Percentage (Pakistan standard GST 18%)
  minStockLevel  Float    @default(5)
  isWeighted     Boolean  @default(false)
  isActive       Boolean  @default(true)
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id])
  batches           ProductBatch[]
  inventoryBalances InventoryBalance[]
  stockLedgers      StockLedger[]
  saleItems         SaleItem[]
  grnItems          GoodsReceiptItem[]
  poItems           PurchaseOrderItem[]
  shrinkageLedgers  ShrinkageLedger[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
}

model ProductBatch {
  id            String    @id @default(uuid())
  productId     String
  batchNumber   String
  expiryDate    DateTime?
  purchasePrice Float
  retailPrice   Float
  currentStock  Float     @default(0)
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNumber])
}

model InventoryBalance {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  warehouseId   String
  productId     String
  currentStock  Float    @default(0)
  reservedStock Float    @default(0)
  updatedAt     DateTime @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, warehouseId, productId])
}

model StockLedger {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  warehouseId   String
  productId     String
  type          String   // OPENING_STOCK, SALE, SALE_RETURN, PURCHASE, ADJUSTMENT_ADD, etc.
  quantity      Float
  balanceAfter  Float
  unitCost      Float
  referenceType String?  // SALE, PURCHASE, ADJUSTMENT
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([branchId, createdAt])
}

model CashRegister {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String
  name         String
  terminalCode String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSessions CashSession[]
  sales        Sale[]

  @@unique([branchId, terminalCode])
}

model CashSession {
  id             String    @id @default(uuid())
  tenantId       String
  branchId       String
  registerId     String
  cashierId      String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Float
  closingBalance Float?
  expectedCash   Float?
  cashDifference Float?
  status         String    @default("OPEN") // OPEN, CLOSED
  notes          String?

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashier  User         @relation(fields: [cashierId], references: [id])
  sales    Sale[]
}

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  phone         String
  email         String?
  cnic          String?
  address       String?
  creditLimit   Float    @default(0)
  currentCredit Float    @default(0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([tenantId, phone])
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  companyName    String
  phone          String
  email          String?
  ntn            String?
  strn           String?
  address        String?
  paymentTerms   String?  // e.g. "Net 30", "Cash on Delivery"
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([tenantId, phone])
}

model Sale {
  id            String   @id @default(uuid())
  localId       String?  @unique // Used for offline desktop POS synchronization
  invoiceNumber String   @unique
  tenantId      String
  branchId      String
  registerId    String
  sessionId     String
  cashierId     String
  customerId    String?
  subtotal      Float
  discountTotal Float    @default(0)
  taxTotal      Float    @default(0)
  grandTotal    Float
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED
  fbrInvoiceNo  String?
  fbrQrCode     String?
  notes         String?
  createdAt     DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  register     CashRegister  @relation(fields: [registerId], references: [id])
  session      CashSession   @relation(fields: [sessionId], references: [id])
  cashier      User          @relation(fields: [cashierId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  returns      SaleReturn[]

  @@index([tenantId, createdAt])
  @@index([branchId, createdAt])
}

model SaleItem {
  id          String @id @default(uuid())
  saleId      String
  productId   String
  productName String
  sku         String
  barcode     String
  unit        String
  unitPrice   Float
  quantity    Float
  discount    Float  @default(0)
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
  total       Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  saleId    String
  tenantId  String
  method    String   // CASH, CARD, BANK_TRANSFER, DIGITAL_WALLET, CREDIT
  amount    Float
  reference String?
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleReturn {
  id             String   @id @default(uuid())
  originalSaleId String
  tenantId       String
  branchId       String
  returnNumber   String   @unique
  refundAmount   Float
  reason         String
  approvedById   String
  createdAt      DateTime @default(now())

  originalSale Sale             @relation(fields: [originalSaleId], references: [id], onDelete: Cascade)
  items        SaleReturnItem[]
}

model SaleReturnItem {
  id          String @id @default(uuid())
  returnId    String
  productId   String
  quantity    Float
  unitPrice   Float
  refundTotal Float

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  tenantId    String
  branchId    String
  supplierId  String
  status      String   @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount Float    @default(0)
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch              @relation(fields: [branchId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float
  totalCost       Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  grnNumber       String   @unique
  purchaseOrderId String?
  tenantId        String
  branchId        String
  supplierId      String
  receivedAt      DateTime @default(now())
  totalAmount     Float    @default(0)
  notes           String?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id               String    @id @default(uuid())
  goodsReceiptId   String
  productId        String
  orderedQuantity  Float
  receivedQuantity Float
  damagedQuantity  Float     @default(0)
  unitCost         Float
  totalCost        Float
  expiryDate       DateTime?
  batchNumber      String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  title         String
  category      String   // UTILITIES, RENT, SALARIES, MAINTENANCE, MARKETING, OTHER
  amount        Float
  paymentMethod String   @default("CASH")
  reference     String?
  notes         String?
  createdById   String
  date          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  type      String   // LOW_STOCK, EXPIRY, PAYMENT_DUE, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}

model SyncQueue {
  id           String    @id @default(uuid())
  deviceId     String
  tenantId     String
  entityType   String    // SALE, REGISTER_SESSION, CUSTOMER
  localId      String
  serverId     String?
  status       String    @default("PENDING") // PENDING, SYNCED, FAILED, CONFLICT
  payload      String
  retryCount   Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  syncedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // SHA-256 hash of 32-byte crypto token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model CustomerLedgerEntry {
  id                String   @id @default(uuid())
  tenantId          String
  customerId        String
  transactionId     String?
  entryType         String   // DEBIT, CREDIT
  amountCents       Int
  balanceAfterCents Int
  notes             String?
  hashChain         String?
  createdAt         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model ShrinkageLedger {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  productId  String
  quantity   Float
  unitCost   Float
  reason     String   // DAMAGED, EXPIRED, RETURN_DAMAGED
  saleId     String?
  notes      String?
  recordedBy String
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
}

model AITenantConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  provider            String   @default("OPENAI") // OPENAI, ANTHROPIC, GEMINI, OLLAMA
  model               String   @default("gpt-4o")
  temperature         Float    @default(0.2)
  encryptedApiKey     String?  // AES-256-GCM encrypted
  iv                  String?
  authTag             String?
  monthlyBudgetTokens Int      @default(500000)
  usedTokensMonth     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AIUsageLedger {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costEstimate     Float    @default(0)
  provider         String
  model            String
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

model ProcessedMutation {
  id           String   @id @default(uuid())
  tenantId     String
  mutationId   String   @unique // X-Idempotency-Key
  entityType   String
  responseBody String   // Cached JSON response
  createdAt    DateTime @default(now())

  @@index([tenantId, mutationId])
}


