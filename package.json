{
  "name": "cash-and-carry-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "seed": "pnpm --filter @cash-carry/database seed",
    "db:push": "pnpm --filter @cash-carry/database db:push",
    "db:generate": "pnpm --filter @cash-carry/database generate"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  }
}
