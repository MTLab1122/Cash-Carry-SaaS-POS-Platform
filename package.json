{
  "name": "cash-and-carry-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "seed": "pnpm --filter @cash-carry/database seed",
    "test:security": "pnpm --filter @cash-carry/database test:security",
    "test:routing": "pnpm --filter @cash-carry/database test:routing",
    "test:seo": "pnpm --filter @cash-carry/database test:seo",
    "test:financials": "pnpm --filter @cash-carry/database test:financials",
    "test:ai-isolation": "pnpm --filter @cash-carry/database test:ai-isolation",
    "test:offline-sync": "pnpm --filter @cash-carry/database test:offline-sync",
    "test:e2e": "pnpm --filter @cash-carry/database test:e2e",
    "test:live-audit": "pnpm --filter @cash-carry/database test:live-audit",
    "db:push": "pnpm --filter @cash-carry/database db:push",
    "db:generate": "pnpm --filter @cash-carry/database generate"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  }
}

